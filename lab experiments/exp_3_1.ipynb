    "# Tower of Hanoi in Prolog\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "hanoi(N) :-\n",
    "    move(N, left, middle, right).\n",
    "\n",
    "move(0, _, _, _) :- !.\n",
    "move(N, A, B, C) :-\n",
    "    N > 0,\n",
    "    M is N - 1,\n",
    "    move(M, A, C, B),\n",
    "    write('Move disk from '),\n",
    "    write(A),\n",
    "    write(' to '),\n",
    "    write(C),\n",
    "    nl,\n",
    "    move(M, B, A, C).\n"
   ]
  }
 ],
