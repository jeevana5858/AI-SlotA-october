          "text": [
            "?- father(X, kumar).\n",
            "X = ram.\n",
            "\n",
            "?- mother(X, kumar).\n",
            "X = sita.\n",
            "\n",
            "?- sibling(kumar, X).\n",
            "false.\n",
            "\n",
            "?- sibling(arun, X).\n",
            "X = arun.\n"
          ]
        }
      ],
      "source": [
        "% Facts\n",
        "male(ram).\n",
        "male(kumar).\n",
        "male(arun).\n",
        "\n",
        "female(sita).\n",
        "female(priya).\n",
        "\n",
        "% Parent relationships\n",
        "parent(ram, kumar).\n",
        "parent(sita, kumar).\n",
        "parent(kumar, arun).\n",
        "parent(priya, arun).\n",
        "\n",
        "% Rules\n",
        "father(X, Y) :-\n",
        "    male(X),\n",
        "    parent(X, Y).\n",
        "\n",
        "mother(X, Y) :-\n",
        "    female(X),\n",
        "    parent(X, Y).\n",
        "\n",
        "sibling(X, Y) :-\n",
        "    parent(Z, X),\n",
        "    parent(Z, Y),\n",
        "    X \\\= Y.\n"
      ]
    }
  ],
